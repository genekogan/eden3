{
  "id": "eden3-channel-runtime",
  "activation": { "onStartup": true },
  "name": "Eden Hosted Channel Runtime",
  "description": "Meters, mirrors, pairs, and reports Eden-hosted Discord and Telegram accounts.",
  "version": "0.1.0",
  "configSchema": {
    "type": "object",
    "properties": {
      "accounts": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "channel",
            "accountId",
            "connectionId",
            "agentId",
            "model",
            "agentRuntime"
          ],
          "properties": {
            "channel": { "enum": ["discord", "telegram"] },
            "accountId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "connectionId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "bindingId": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "agentId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "model": { "type": "string", "minLength": 3, "maxLength": 300 },
            "agentRuntime": { "enum": ["openclaw", "claude-cli"] }
            ,
            "groups": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "object",
                "required": ["conversationId", "guildId", "allowFrom", "mentionRequired"],
                "properties": {
                  "conversationId": { "type": "string", "pattern": "^-?[0-9]{3,25}$" },
                  "guildId": { "type": ["string", "null"], "pattern": "^[0-9]{3,25}$" },
                  "allowFrom": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": { "type": "string", "pattern": "^-?[0-9]{3,25}$" }
                  },
                  "mentionRequired": { "const": true }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      }
    },
    "required": ["accounts"],
    "additionalProperties": false
  }
}
