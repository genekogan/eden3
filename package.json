{
  "name": "eden3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @eden3/api dev\" \"pnpm --filter @eden3/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:standalone && node scripts/credential-exposure.mjs",
    "test:standalone": "node scripts/standalone-test-manifest.mjs",
    "test:semantic-skips": "node --test scripts/semantic-test-controls.test.mjs",
    "test:credential-exposure": "node --test scripts/credential-exposure.test.mjs && node scripts/credential-exposure.mjs",
    "test:api-full": "pnpm --filter @eden3/api test:full",
    "test:db-scratch-full": "pnpm --filter @eden3/db test:scratch-full",
    "typecheck": "pnpm -r typecheck",
    "etl": "pnpm --filter @eden3/etl etl",
    "etl:verify": "pnpm --filter @eden3/etl etl:verify",
    "etl:snapshot": "node scripts/create-etl-mongo-snapshot.mjs",
    "etl:parity": "bash scripts/etl-parity-db.sh",
    "eve:reconcile": "pnpm --filter @eden3/api eve:reconcile",
    "autonomy:smoke": "node scripts/autonomy-smoke.mjs",
    "load:gateway": "node scripts/load-gateway.mjs",
    "load:gateway:test": "node --test scripts/load-gateway.test.mjs",
    "test:service-exposure": "node --test infra/service-exposure.test.mjs",
    "tunnel:api": "bash scripts/tunnel.sh --api",
    "tunnel:web": "bash scripts/tunnel.sh --web",
    "tunnel:stop": "bash scripts/tunnel-stop.sh",
    "db:generate": "pnpm --filter @eden3/db generate",
    "db:migrate": "pnpm --filter @eden3/db migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^22.15.34",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "yaml": "2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
