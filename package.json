{
  "name": "eden3",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"pnpm --filter @eden3/api dev\" \"pnpm --filter @eden3/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test && pnpm test:credential-exposure",
    "test:credential-exposure": "node --test scripts/credential-exposure.test.mjs && node scripts/credential-exposure.mjs",
    "test:api-full": "pnpm --filter @eden3/api test:full",
    "test:db-scratch-full": "pnpm --filter @eden3/db test:scratch-full",
    "test:api-managed-postgres": "pnpm --filter @eden3/api test:managed-postgres",
    "typecheck": "pnpm -r typecheck",
    "eve:reconcile": "pnpm --filter @eden3/api eve:reconcile",
    "load:postgres-metrics": "pnpm --filter @eden3/api load:postgres-metrics",
    "db:generate": "pnpm --filter @eden3/db generate",
    "db:migrate": "pnpm --filter @eden3/db migrate",
    "db:managed-preflight": "pnpm --filter @eden3/db managed:preflight",
    "db:managed-bootstrap-runtime": "pnpm --filter @eden3/db managed:bootstrap-runtime",
    "db:managed-upgrade-runtime-voice": "pnpm --filter @eden3/db managed:upgrade-runtime-voice"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@types/node": "^22.15.34",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.4",
    "pnpm": "10.27.0",
    "postgres": "^3.4.9",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "yaml": "2.8.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
