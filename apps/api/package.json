{
  "name": "@eden3/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "eve:reconcile": "tsx src/eve-reconcile.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "test:eve-reconciliation": "vitest run --config vitest.eve-reconciliation.config.ts",
    "test:integration": "bash ../../scripts/with-docker-env.sh vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@eden3/core": "workspace:*",
    "@eden3/db": "workspace:*",
    "@eden3/gateway": "workspace:*",
    "@eden3/shared": "workspace:*",
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^9.1.1",
    "archiver": "^8.0.0",
    "chokidar": "^4.0.3",
    "drizzle-orm": "^0.45.2",
    "eventsource-parser": "^3.0.3",
    "fastify": "^5.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "postgres": "^3.4.9",
    "vitest": "^3.2.4"
  }
}
