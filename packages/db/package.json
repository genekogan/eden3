{
  "name": "@eden3/db",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./catalog-lock": "./src/catalog-lock.ts",
    "./managed-postgres-preflight": "./src/managed-postgres-preflight.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "managed:preflight": "tsx src/managed-preflight-cli.ts",
    "managed:bootstrap-runtime": "tsx src/managed-runtime-bootstrap-cli.ts",
    "managed:upgrade-runtime-voice": "tsx src/managed-runtime-voice-upgrade-cli.ts",
    "managed:runtime-rehearsal": "tsx src/managed-runtime-rehearsal-cli.ts",
    "studio": "drizzle-kit studio",
    "ping": "tsx src/ping.ts",
    "ready": "tsx src/ready.ts",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:catalog-readonly": "vitest run --config vitest.readonly-catalog.config.ts",
    "test:scratch-full": "pnpm test && pnpm test:integration",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
