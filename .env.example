# Eden3 working-prototype configuration.
# Copy to .env.local and replace every CHANGEME value you enable.
# Never commit the populated file.

# Core database (required)
EDEN3_DATABASE_NAME=eden3_local
POSTGRES_USER=eden3_local
POSTGRES_PASSWORD=CHANGEME_DATABASE_PASSWORD
POSTGRES_PORT=5432
DATABASE_URL=postgresql://eden3_local:CHANGEME_DATABASE_PASSWORD@127.0.0.1:5432/eden3_local

# Application origins and ports
API_PORT=4301
WEB_PORT=4300
NEXT_PUBLIC_API_ORIGIN=http://127.0.0.1:4301
API_INTERNAL_URL=http://127.0.0.1:4301
MEDIA_BASE_URL=/media
NEXT_PUBLIC_LEGACY_MEDIA_ORIGIN=
NEXT_PUBLIC_LEGACY_MEDIA_HOSTS=
OBJECT_LEGACY_HTTPS_HOSTS=

# Writable runtime data (required; use absolute paths outside source control)
MEDIA_DIR=/tmp/eden3-local/media
VOICE_OUTPUT_DIR=/tmp/eden3-local/voice-output
TRANSCRIPTION_AUDIO_DIR=/tmp/eden3-local/transcriptions
OPENCLAW_DATA_DIR=/tmp/eden3-local/openclaw-data

# OpenClaw gateway (required for real agent/chat execution)
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=CHANGEME_OPENCLAW_GATEWAY_TOKEN

# Authentication. Use dev only on a loopback-only local instance.
AUTH_PROVIDER=dev
EDEN3_DEV_ROUTES=1
ADMIN_USERNAMES=local-admin
ACCESS_ALLOWLIST=

# Clerk (required only when AUTH_PROVIDER=clerk or hybrid).
# CLERK_JWT_KEY is mandatory for clerk and hybrid verification; there is no JWKS fallback.
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:4300
CLERK_NEW_USER_SEED_MANNA=100

# Random 32-byte base64 key, required when channel credentials are enabled.
CHANNEL_TOKEN_ENCRYPTION_KEY=

# Optional media/transcription/voice providers
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
DEEPINFRA_API_KEY=

# Optional model-provider credentials. Prefer placing these in OpenClaw's
# operator-owned runtime environment rather than the Eden3 API process.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional S3-compatible object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional Stripe billing. Use only sandbox/test credentials in evaluation.
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MANNA_TOPUP_PRICE_ID=
STRIPE_MANNA_TOPUP_AMOUNT=10000
STRIPE_SUBSCRIPTION_BASIC_PRICE_ID=
STRIPE_SUBSCRIPTION_PRO_PRICE_ID=
STRIPE_SUBSCRIPTION_BELIEVER_PRICE_ID=
STRIPE_SUBSCRIPTION_BASIC_MONTHLY_MANNA=10000
STRIPE_SUBSCRIPTION_PRO_MONTHLY_MANNA=35000
STRIPE_SUBSCRIPTION_BELIEVER_MONTHLY_MANNA=100000
BILLING_SUCCESS_URL=http://127.0.0.1:4300/manna?checkout=success
BILLING_CANCEL_URL=http://127.0.0.1:4300/manna?checkout=cancel

# Optional messaging channels; values are supplied by your own provider apps.
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Limits and scheduling
MAX_NATIVE_AGENTS_PER_USER=25
MAX_SCHEDULED_TASKS_PER_USER=100
MAX_CONCURRENT_TURNS_PER_USER=2
MAX_CONCURRENT_TURNS_GLOBAL=10
MAX_QUEUED_TURNS_GLOBAL=50
TURN_QUEUE_TIMEOUT_MS=30000
DAILY_MANNA_SPEND_CAP_PER_USER=10000
API_BODY_LIMIT_BYTES=1000000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
